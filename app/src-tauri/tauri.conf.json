{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mares Apneist",
  "version": "0.1.0",
  "identifier": "it.j7044.mares-apneist",
  "build": {
    "frontendDist": "../ui",
    "beforeDevCommand": "node scripts/copy-ui.js",
    "beforeBuildCommand": "node scripts/copy-ui.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Logbook Apneist",
        "width": 1240,
        "height": 860,
        "minWidth": 720,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Italian"],
        "installMode": "currentUser"
      }
    }
  }
}
